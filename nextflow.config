manifest {
    name = 'pdac-bayesprism-nf'
    nextflowVersion = '>=24.10.0'
    mainScript = 'main.nf'
}

params {
    mixtures = null    // glob of samples x genes count-matrix RDS files, one per RNA source
    reference = null   // RDS list(sc.dat, cell.type.labels, cell.state.labels, key = 'Malignant', ...)
    outdir = null
}

process {
    container = 'docker.io/bioconductor/bioconductor_docker:RELEASE_3_21'
    withName: BAYESPRISM {
        cpus = 16
        memory = 64.GB
        time = 12.h
        errorStrategy = { task.exitStatus in [137, 143, 104] ? 'retry' : 'terminate' }
        maxRetries = 1
    }
}
